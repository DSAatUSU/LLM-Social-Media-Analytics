# Copy to .env and `source .env` (or export the variables in your shell).
# The scripts read every key from the environment; nothing is hard-coded.
export OPENAI_API_KEY=""        # GPT-4, GPT-4o, GPT-3.5-Turbo
export GEMINI_API_KEY=""        # Gemini 1.5 Pro (gemini-1.5-pro-002)
export DEEPSEEK_API_KEY=""      # DeepSeek-V3 (deepseek-chat)

# Local copy of the Twitter/X dataset (not distributed with this repository)
export VAPOR_DESCRIPTIONS="/path/to/user_descriptions_rounds.xlsx"
export VAPOR_TWEETS="/path/to/tweets_no_duplicates.csv"
export VAPOR_GRAPHS="/path/to/graphs"
